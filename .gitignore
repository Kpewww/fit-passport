# Node / Next.js
app-web/node_modules
app-web/.next
app-web/out
app-web/build
app-web/coverage

# Prisma / SQLite dev DB
app-web/prisma/dev.db
app-web/prisma/dev.db-journal
# Generated production schema (derived from schema.prisma at build time)
app-web/prisma/schema.postgres.prisma

# Env & secrets (do NOT commit real credentials)
# Ignore all .env variants anywhere, but keep .env.example templates.
.env
.env.local
.env.development
.env.production
**/.env
**/.env.local
**/.env.development
**/.env.production

# OS / IDE
.DS_Store
.vscode
.idea

# Logs
*.log
/tmp/*.log

# Evaluation captures of retailer pages stay local until the founder decides
# they may be committed (eval/README.md, "Captures").
app-web/eval/local/

# The Chrome Web Store package (pack-extension.mjs --store): uploaded by hand,
# rebuilt from browser-extension/ at any time.
app-web/store-build/
# Videos of the mark's reveal, made by app-web/scripts/record-logo.mjs (Session 89).
app-web/brand-build/

# Vercel CLI link metadata (project/org ids)
app-web/.vercel
.vercel

# Python bytecode (tools/anny)
__pycache__/
