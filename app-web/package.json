{
  "name": "app-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "db:push": "prisma db push --skip-generate && prisma generate",
    "docs:pdf": "node scripts/md-to-pdf.mjs --all",
    "db:pg:schema": "node scripts/gen-postgres-schema.mjs",
    "db:pg:migrate": "npm run db:pg:schema && prisma migrate deploy --schema prisma/schema.postgres.prisma",
    "db:pg:generate": "npm run db:pg:schema && prisma generate --schema prisma/schema.postgres.prisma",
    "vercel-build": "npm run db:pg:generate && prisma migrate deploy --schema prisma/schema.postgres.prisma && next build",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "@types/three": "^0.169.0",
    "bcryptjs": "^2.4.3",
    "framer-motion": "^11.18.2",
    "lenis": "^1.3.26",
    "next": "14.2.15",
    "prisma": "^5.22.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "three": "^0.169.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/react": "^18.3.1",
    "@types/react-dom": "^18.3.1",
    "autoprefixer": "^10.4.20",
    "eslint": "^8.57.1",
    "eslint-config-next": "14.2.15",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.14",
    "typescript": "^5",
    "vitest": "^1.6.0"
  }
}
