# Copy to .env and fill in. The real .env is gitignored.

# SQLite dev database (Prisma).
DATABASE_URL="file:./dev.db"

# Secret used to sign session cookies (HMAC). MUST be set to a long random
# value in any non-local deployment. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# If unset, the app falls back to an insecure dev default (fine for localhost only).
SESSION_SECRET=""

# Anthropic key — OPTIONAL. If set, /api/check upgrades from the deterministic
# URL-derived extractor to Claude Haiku 4.5, which reads the actual product
# page for real sizing + product image. If unset, the app still works — it
# just uses the synthetic size ladder from brand/URL keywords.
# Cost: ~$0.007 per check with Haiku. Never sends user body measurements —
# only the page text. See src/lib/extractorLLM.ts.
ANTHROPIC_API_KEY=""

# Photoreal outfit try-on — OPTIONAL. Our LLM can't render images, so this points
# at a text-to-image / virtual-try-on endpoint. When set, the Outfits page's
# "✨ Photoreal preview" button generates a model image; otherwise it falls back
# to the stylized SVG mannequin. The endpoint must accept POST { prompt } and
# return { url } | { image } | { b64 }. Only a coarse body descriptor + garment
# list are sent — never precise measurements. See src/lib/tryonImage.ts.
TRYON_API_URL=""
TRYON_API_KEY=""

# EASIEST photoreal option: a Replicate token. If set, the try-on uses FLUX
# schnell (~$0.003/image) with no endpoint wiring needed. Get one at
# replicate.com/account/api-tokens. Takes precedence over TRYON_API_URL.
REPLICATE_API_TOKEN=""

# Password-reset emails — OPTIONAL. Uses Resend (free tier ~3,000/mo). Without
# these, /recover shows the reset link on-screen (dev/beta) instead of emailing.
# Get a key at resend.com; EMAIL_FROM must be a verified sender/domain.
RESEND_API_KEY=""
EMAIL_FROM=""

# Public base URL used to build absolute links (e.g. reset emails). Defaults to
# the request origin when unset; set it in production.
APP_URL=""
