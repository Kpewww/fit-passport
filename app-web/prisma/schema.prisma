// Fit Passport — data model
// Design principle from the proposal: the shopper OWNS their fit identity.
// One User has one FitProfile (their portable passport), a closet of KnownGoodItems,
// zero-or-more Products they've checked (each with SizeOptions),
// FitRecommendations produced by the engine, and FitOutcomes recording what actually happened.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ---------- Identity ----------

model User {
  id          String   @id @default(cuid())
  email       String?  @unique
  displayName String?
  createdAt   DateTime @default(now())

  // ---- Code-based identity (see docs/design/identity-and-sharing.md) ----
  // An anonymous session starts unclaimed. Once the user "claims" the account
  // (sets username + password), it becomes shareable by accountCode.
  claimed      Boolean @default(false)
  // High-entropy public identifier. Anyone with it can READ the closet (+coarse
  // body type), never precise measurements. Nullable until claimed.
  accountCode  String? @unique
  username     String? @unique
  // bcrypt hash of the edit password (the "private key"). Never store plaintext.
  passwordHash String?
  // bcrypt hash of a one-time recovery code (no email = need a recovery path).
  recoveryHash String?
  // Password-reset token flow (real email link). We store a HASH of the token
  // plus its expiry; the plaintext token only lives in the emailed link.
  resetTokenHash String?
  resetExpiresAt DateTime?
  // Soft-deactivation: when true the account is hidden from ALL external access
  // (public view, community, login) but data is retained. Not a hard delete.
  deactivated  Boolean @default(false)
  // Coarse, shareable body type shown to code viewers, e.g. "slim"|"average"|
  // "athletic"|"broad". Precise cm measurements live in FitProfile and are
  // NEVER exposed by code. Default null = viewer sees nothing about the body.
  bodyType     String?
  // Export policy for code viewers: "owner" (only password holder) | "anyone".
  exportPolicy String  @default("owner")

  // Opt-in to the public community directory (browsable list of closets).
  // Off by default — publishing is always a deliberate choice.
  listedInCommunity Boolean @default(false)

  // Up to 3 badge IDs the user has pinned to their passport, comma-separated,
  // in display order. The full earned set is derived on the fly (see badges.ts);
  // this only records which ones they chose to show off.
  pinnedBadges String @default("")

  // Whether the coarse body type is shown on the passport / public view. The
  // body type value itself may be set but hidden — this is a separate choice.
  showBodyType Boolean @default(true)

  // Optional "signature look" — the id of one of the user's own outfits to
  // feature on the passport. Null = none chosen.
  signatureOutfitId String?

  // Chosen colour/metal of the passport card (and the user's community banner).
  // Must be a metal the user has actually EARNED — validated server-side.
  // Null = automatic (their highest earned metal, else the default lapis).
  cardMetal String?

  /// Which fit-input mode this person sees: "descriptive" (five words) or
  /// "numeric" (the signed -10..+10 scale). Sticky PER USER, never per item —
  /// switching mid-closet would make their own data incomparable with itself.
  fitScaleMode String @default("descriptive")

  /// Sequential membership number, shown on the passport as "No. 00000042".
  /// Assigned when an account is CLAIMED — it's a membership number, so an
  /// anonymous session hasn't got one yet. Not autoincrement: SQLite only allows
  /// that on the primary key, so /api/auth/claim takes max+1 and relies on the
  /// unique constraint to reject the rare race.
  memberNo Int? @unique

  /// "USER" | "ADMIN". Admins get the moderation review queue at /admin.
  /// Only settable by scripts/seed-admin.mjs — there is deliberately no API that
  /// grants this, because an endpoint that can mint admins is an endpoint that
  /// can be abused into minting admins.
  role String @default("USER")

  /// DEMO ONLY: show every badge as earned regardless of stats.
  ///
  /// This exists so the founder's demo account can present the whole prestige
  /// ladder in a pitch. It deliberately does NOT fake the underlying stats —
  /// `computeBadgeStats` still returns the truth — and it can only be set by the
  /// seed script. Real accounts earn badges or don't have them.
  grantAllBadges Boolean @default(false)

  fitProfile  FitProfile?
  petProfiles PetProfile[]
  knownGood   KnownGoodItem[]
  collections Collection[]
  products    Product[]
  outcomes    FitOutcome[]
  recs        FitRecommendation[]
  outfits     Outfit[]
  outfitLikes OutfitLike[]
  following   Follow[] @relation("follower")
  followers   Follow[] @relation("followee")
  posts       Post[]
  answers     Answer[]
  answerVotes AnswerVote[]
  reports     Report[]
  blocking    Block[] @relation("blocker")
  blockedBy   Block[] @relation("blocked")
}

/// A block. One-directional and private: the blocked person is never told.
///
/// Reporting handles content that breaks the rules; blocking handles someone you
/// simply don't want to see. Both are needed — telling a user to report somebody
/// they merely find unpleasant is how moderation queues fill with noise.
///
/// Effect: their looks, questions and answers disappear from your feeds, and
/// yours from theirs (blocks are enforced BOTH ways, so blocking is also an exit
/// from someone else's attention).
model Block {
  id String @id @default(cuid())

  blockerId String
  blocker   User   @relation("blocker", fields: [blockerId], references: [id], onDelete: Cascade)
  blockedId String
  blocked   User   @relation("blocked", fields: [blockedId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([blockerId, blockedId])
  @@index([blockedId])
}

// ---------- Moderation ----------

/// A report on user-generated content.
///
/// Anonymous-friendly, like votes: keyed by session so a first-time visitor who
/// lands on something abusive can still flag it. Unique per (target, reporter) so
/// one person can't manufacture a takedown by clicking repeatedly.
///
/// Reports are a SIGNAL, not a verdict — see lib/reports.ts for the auto-hide
/// rule and its known weakness (coordinated reporting). The operator script at
/// scripts/moderate.mjs is the authoritative takedown/restore path.
model Report {
  id String @id @default(cuid())

  /// "POST" | "ANSWER" | "OUTFIT" — validated in lib/reports.ts.
  kind     String
  targetId String

  reporterKey String
  userId      String?
  user        User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  /// Why, from a fixed list. Free text goes in `note`.
  reason String
  note   String?

  createdAt DateTime @default(now())

  @@unique([kind, targetId, reporterKey])
  @@index([kind, targetId])
}

/// A one-directional follow. This is the cheapest retention primitive we have:
/// it turns one global chronological feed into a feed the member chose (see
/// docs/design/community-ecosystem.md, sequencing step 1).
///
/// Both sides must be CLAIMED accounts. A follow needs a durable identity to
/// mean anything, and requiring it keeps follower counts honest — an anonymous
/// session is free to create, so allowing it would make counts inflatable.
model Follow {
  id String @id @default(cuid())

  followerId String
  follower   User   @relation("follower", fields: [followerId], references: [id], onDelete: Cascade)
  followeeId String
  followee   User   @relation("followee", fields: [followeeId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  // One follow per pair; re-following is idempotent rather than duplicated.
  @@unique([followerId, followeeId])
  @@index([followeeId])
}

// ---------- Outfits (community posts) ----------

/// A posted outfit — a curated look the user shares to the community. Composed
/// of one or more garments (OutfitItem), can gather likes, and drives the top
/// prestige badges (Stylist / Acclaimed / Head Designer).
model Outfit {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  title       String
  description String?
  // Season / occasion tag, free-text and optional ("Fall", "Wedding", …).
  occasion    String?
  // If the whole look is only buyable in-store (nothing online), flag it.
  onlineAvailable Boolean @default(true)

  /// Taken down after reports (or by an operator). Hidden content stays visible
  /// to its author — so they know why it vanished — and to nobody else.
  hidden Boolean @default(false)

  createdAt DateTime @default(now())

  items OutfitItem[]
  likes OutfitLike[]

  @@index([userId])
  @@index([createdAt])
}

/// One garment slot within an outfit. May reference a closet item, or be a
/// free-typed piece (with a color) so users can compose looks beyond their
/// closet. `onlineAvailable=false` marks a piece that's in-store only.
model OutfitItem {
  id       String @id @default(cuid())
  outfitId String
  outfit   Outfit @relation(fields: [outfitId], references: [id], onDelete: Cascade)

  // Optional link back to a closet item (for real garments the user owns).
  knownGoodId String?

  brand    String?
  category String // garment type (drives the mannequin layer)
  color    String?
  size     String?
  note     String?
  onlineAvailable Boolean @default(true)
  sortIndex Int    @default(0)

  @@index([outfitId])
}

/// A like on an outfit. Anonymous-friendly: keyed by a voter token (session id)
/// so unclaimed visitors can like, deduped per outfit. Claimed users also store
/// userId. Unique on (outfitId, voterKey) prevents double-likes per session.
model OutfitLike {
  id       String @id @default(cuid())
  outfitId String
  outfit   Outfit @relation(fields: [outfitId], references: [id], onDelete: Cascade)

  voterKey String // session id (or userId for claimed users)
  userId   String?
  user     User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@unique([outfitId, voterKey])
  @@index([outfitId])
}

// ---------- Ask & Answer (community Q&A) ----------

/// A question or recommendation thread. This is the community's utility loop
/// (docs/design/community-ecosystem.md, step 2).
///
/// What makes it ours rather than a generic forum: both the question and every
/// answer may ATTACH a real closet item as evidence, so a reply carries "this
/// brand in this size fits a body like mine", not just an opinion.
model Post {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// "HELP" (will this fit me?) | "RECOMMEND" (what should I buy?) |
  /// "VERDICT" (I kept/returned this — here's why). Validated in lib/posts.ts.
  kind  String
  title String
  body  String

  /// Optional evidence from the ASKER's own closet — their reference garment.
  /// A loose id, not a relation, matching OutfitItem.knownGoodId: if the item is
  /// later deleted the attachment simply resolves to nothing.
  knownGoodId String?
  /// Optional product link the question is about. Text only — we never store or
  /// display scraped brand imagery.
  productUrl String?

  /// The answer the asker marked as the one that solved it. Nullable = unresolved.
  resolvedAnswerId String?

  /// Taken down after reports (or by an operator). See the Report model.
  hidden Boolean @default(false)

  createdAt DateTime @default(now())

  answers Answer[]

  @@index([userId])
  @@index([createdAt])
}

/// A reply to a Post, optionally backed by a garment the answerer actually owns.
model Answer {
  id     String @id @default(cuid())
  postId String
  post   Post   @relation(fields: [postId], references: [id], onDelete: Cascade)
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  body String
  /// Evidence from the ANSWERER's closet — ownership is validated on write.
  knownGoodId String?

  /// Taken down after reports (or by an operator). See the Report model.
  hidden Boolean @default(false)

  createdAt DateTime @default(now())

  votes AnswerVote[]

  @@index([postId])
  @@index([userId])
}

/// A "helpful" vote on an answer. Same anonymous-friendly shape as OutfitLike:
/// keyed by a voter token so unclaimed visitors can still signal usefulness,
/// deduped per answer.
model AnswerVote {
  id       String @id @default(cuid())
  answerId String
  answer   Answer @relation(fields: [answerId], references: [id], onDelete: Cascade)

  voterKey String
  userId   String?
  user     User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@unique([answerId, voterKey])
  @@index([answerId])
}

// ---------- The Passport itself ----------

/// One consolidated body + preference record per user.
/// Every measurement is optional. Cold-start users can leave everything blank
/// and rely on KnownGoodItem anchors instead.
model FitProfile {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Biological sex — used as a sizing reference (men's vs women's size systems
  // differ). Optional. "male" | "female" | "unspecified". This is about which
  // size CHARTS map to the body; the user is free to shop any department's cut
  // (men buying women's, women buying men's), which `shopsFor` captures.
  sex      String? // biological sex for sizing reference
  // Which departments the user actually shops (may differ from `sex`).
  // Comma-separated of "mens","womens","unisex". Null = no preference stated.
  shopsFor String?

  // Basic body info (all optional, all in metric — cm/kg — for storage)
  heightCm   Float?
  weightKg   Float?
  chestCm    Float?
  waistCm    Float?
  hipCm      Float?
  shoulderCm Float?
  sleeveCm   Float?
  inseamCm   Float?

  // Fit preference for tops/jackets. Comma-separated, up to 3 of
  // "slim"|"regular"|"relaxed"|"oversized". The FIRST is the primary target the
  // engine defaults to; the rest are acceptable alternatives the user is open to.
  preferredFit String @default("regular")

  // Region for size chart defaults. e.g. "US","EU","UK","JP","CN"
  region String @default("US")

  // Optional portrait — a small client-resized data URL (data:image/...;base64).
  // Purely cosmetic for the passport page. Never exposed by account code.
  avatarDataUrl String?

  // Optional free-text notes (allergies to fabrics, "long torso", etc)
  notes String?

  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())
}

/// A user-owned, renamable folder for organizing the closet. This is the
/// "category" the USER sees and edits (rename / reorder / move items between).
/// Distinct from KnownGoodItem.category, which is the GARMENT TYPE the fit
/// engine matches on and must not be renamed by users.
model Collection {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  name      String // "T-Shirts", "Jeans", "Winter", user-editable
  sortIndex Int      @default(0)
  // User-chosen folder color KEY (e.g. "amber","sky","emerald"). Null = auto
  // color picked by position. Purely cosmetic for the folder view.
  color     String?
  createdAt DateTime @default(now())

  items KnownGoodItem[]

  @@index([userId])
}

/// A garment the user already owns and considers a good fit — the anchor points
/// the fit engine relies on when the user has no measurements.
model KnownGoodItem {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  brand         String // e.g. "Uniqlo"
  // Optional user-chosen name for the piece ("Blue Oxford", "Dad's jacket").
  // Falls back to "brand + category" in the UI when empty.
  displayName   String?
  category      String // GARMENT TYPE for the engine: "shirt"|"tshirt"|"jacket"|...
  gender        String? // which line the garment is from: "mens"|"womens"|"unisex". Optional.
  size          String // as-labeled: "M", "L", "EU 48", "US 32"
  region        String? // if the label uses a specific region
  fitRating     Int     @default(4) // 1-5 how well it fits
  /// SIGNED fit direction: -10 (too tight) .. 0 (just right) .. +10 (too loose).
  /// `fitRating` says how GOOD the fit is; this says WHICH WAY it is wrong, which
  /// is the signal the size-recommendation literature actually models and the one
  /// the engine can act on. Null = never reported (legacy items), and the engine
  /// then behaves exactly as it did before. See lib/fitDirection.ts.
  fitDirection  Int?
  // Optional area-specific notes (JSON string)
  // shape: {"shoulders":"comfortable","chest":"slightly tight","sleeve":"long"}
  areaNotesJson String?

  // ---- Phase 2 organization fields ----
  collectionId String? // which user folder it lives in (null = Uncategorized)
  collection   Collection? @relation(fields: [collectionId], references: [id], onDelete: SetNull)
  color        String? // free-text/hex-ish color tag, e.g. "navy", "#1a2b3c"
  sortIndex    Int         @default(0) // manual order within a collection
  // Variant grouping: items sharing a groupId are the SAME garment in different
  // sizes/colors, collapsed into one card in the UI. Null = standalone. The fit
  // engine still reads every item individually, so grouping is display-only.
  groupId      String?
  groupName    String? // optional label for the merged card

  // ---- The garment's OWN measurements, captured at add-by-URL time ----
  // The extractor already reads a full size chart when someone pastes a product
  // link; before this it returned only the labels and threw the numbers away.
  // Keeping them is what makes `ease = garment − body` computable for a garment
  // the user OWNS AND LIKES, which is the strongest ease signal available —
  // a size chart alone says how a brand cuts, this says what actually worked.
  // All nullable: items added by hand, or from a page with no chart, have none.
  garmentChestCm    Float?
  garmentShoulderCm Float?
  garmentSleeveCm   Float?
  garmentLengthCm   Float?
  /// Where those numbers came from: "page" (read off the retailer's own chart)
  /// or "estimated" (the extractor's fallback ladder). Never blank when any
  /// measurement above is set — an unlabelled number is indistinguishable from
  /// a measured one, which is the failure mode `source.sizesFrom` exists to stop.
  garmentMeasuredFrom String?

  productUrl  String? // optional link so we can back-refer to the source
  // Optional USER-UPLOADED photo of the item (small client-resized data URL).
  // We deliberately store the user's own photo, not scraped brand imagery, to
  // avoid trademark/copyright issues. See DEVLOG Session 19 note.
  imageDataUrl String?
  // Some garments aren't sold online (local shops, thrift, tailor). When false,
  // the UI shows an "in-store only" note instead of implying a link exists.
  onlineAvailable Boolean @default(true)
  purchasedAt DateTime?
  createdAt   DateTime  @default(now())
  // JSON array of ISO timestamps marking each "formal" edit session. Rapid
  // successive edits coalesce into one entry (see closet PATCH); the last entry
  // is the most-recent modification, the rest are the edit history.
  editHistory String?

  comfortChecks ComfortCheck[]

  @@index([userId])
  @@index([collectionId])
  @@index([groupId])
}

/// A time-stamped record of how a garment felt on a given date. Bodies change,
/// so the "how well it fits" rating drifts over time. Each Fit Refresh pass
/// appends one ComfortCheck per item the user (re-)rated. KnownGoodItem.fitRating
/// always mirrors the LATEST check; this table keeps the full history for trends.
model ComfortCheck {
  id     String        @id @default(cuid())
  itemId String
  item   KnownGoodItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  userId String

  rating Int // 1-5 comfort at this point in time
  /// Signed fit direction at this point in time (-10 tight .. +10 loose), so the
  /// history records which way a garment drifted, not just that it got worse.
  /// Null for checks recorded before the signed scale existed.
  direction Int?
  // Optional reason the user gives when it changed, e.g. "tighter after winter".
  note   String?
  // Why this check happened: "refresh" (manual pass) | "measurement-change" | "add".
  reason String  @default("refresh")

  createdAt DateTime @default(now())

  @@index([itemId])
  @@index([userId])
}

// ---------- Products the user has checked ----------

model Product {
  id     String @id @default(cuid())
  userId String // owned by whoever imported it (course-MVP model)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  url           String
  retailer      String? // "uniqlo", "cos", "hm", "amazon", ...
  brand         String?
  productName   String?
  category      String? // shirt/tshirt/jacket/...
  material      String? // free text; stretch info can live in fitNotes
  fitNotes      String? // page's own qualitative notes ("slim through the body")
  modelInfoJson String? // e.g. {"heightCm":183,"wearsSize":"M"}
  rawJson       String? // full extractor payload for debugging / user review

  createdAt   DateTime            @default(now())
  sizeOptions SizeOption[]
  recs        FitRecommendation[]
  outcomes    FitOutcome[]

  @@index([userId])
}

/// One row per available size on the product page. Measurements optional
/// because many retailers only expose alpha labels.
model SizeOption {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  label          String // "M", "EU 48", "US 10"
  region         String? // if the size chart mixes regions
  // Garment (flat) measurements — cm
  chestCm        Float?
  waistCm        Float?
  hipCm          Float?
  shoulderCm     Float?
  sleeveCm       Float?
  lengthCm       Float?
  // Body-based measurements (some brands publish body ranges instead of garment)
  bodyChestMinCm Float?
  bodyChestMaxCm Float?
  bodyWaistMinCm Float?
  bodyWaistMaxCm Float?

  @@index([productId])
}

// ---------- Engine outputs & feedback loop ----------

model FitRecommendation {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  userId    String
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  recommendedSizeLabel String
  confidence           Float // 0..1
  // Per-size scores + reasoning (JSON string)
  // { "sizes": [ { "label":"M","score":0.86,"reasons":[...] }, ... ] }
  breakdownJson        String
  // Short human explanation ("Closest match to your COS M and Uniqlo L...")
  explanation          String

  createdAt DateTime @default(now())

  @@index([userId, productId])
}

/// What actually happened after purchase. This is the ground truth that
/// makes the profile improve over time — the whole thesis of the product.
model FitOutcome {
  id        String  @id @default(cuid())
  userId    String
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  purchasedSize    String
  decision         String // "keep" | "return" | "exchange"
  exchangedForSize String?

  overallFit     Int? // 1-5
  // Area-specific issues (JSON)
  // {"shoulders":"tight","chest":"tight","sleeve":"long","length":"short"}
  areaIssuesJson String?
  notes          String?

  createdAt DateTime @default(now())

  @@index([userId])
}

// ---------- Pet extension (prototype only in the MVP) ----------

model PetProfile {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  name          String
  species       String // "dog" | "cat"
  breed         String?
  bodyType      String? // free text: "deep-chested", "long-back", ...
  weightKg      Float?
  neckCm        Float?
  chestGirthCm  Float?
  backLengthCm  Float?
  // Known-good gear items for pets, JSON list of {brand,category,size,note}
  knownGearJson String?
  notes         String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}
